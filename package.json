{
  "name": "froststained-server-console",
  "version": "0.1.0",
  "private": true,
  "description": "Minecraft Java server management console for LAN",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
